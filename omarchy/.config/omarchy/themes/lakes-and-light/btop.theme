# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#f5e4d8"

# Main text color
theme[main_fg]="#3a1911"

# Title color for boxes
theme[title]="#3a1911"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#805f36"

# Background color of selected item in processes box. #3a1911 maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #f6e7dc gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#f6e7dc"

# Foreground color of selected item in processes box. Use #3a1911 so
# the row text stays readable on the lighter_bg highlight; the previous
# #805f36 produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#3a1911"

# Color of inactive/disabled text
theme[inactive_fg]="#7f7974"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #583c35 caps at #ffffff when the foreground is already pure white, so we
# just bind it to #3a1911 directly.
theme[graph_text]="#3a1911"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #3a1911 collapsed to the main fg.
theme[meter_bg]="#f6e7dc"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #875c26 for a distinct accent instead of #583c35 which capped to white.
theme[proc_misc]="#875c26"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#563819"
theme[mem_box]="#653e00"
theme[net_box]="#562b00"
theme[proc_box]="#805f36"

# Box divider line and small boxes line color
theme[div_line]="#7f7974"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#653e00"
theme[temp_mid]="#7b5521"
theme[temp_end]="#562b00"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#875c26"
theme[cpu_mid]="#805f36"
theme[cpu_end]="#563819"

# Mem/Disk free meter
theme[free_start]="#563819"
theme[free_mid]="#805f36"
theme[free_end]="#875c26"

# Mem/Disk cached meter
theme[cached_start]="#805f36"
theme[cached_mid]="#875c26"
theme[cached_end]="#563819"

# Mem/Disk available meter
theme[available_start]="#7b5521"
theme[available_mid]="#562b00"
theme[available_end]="#562b00"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#653e00"
theme[used_mid]="#875c26"
theme[used_end]="#805f36"

# Download graph colors
theme[download_start]="#7b5521"
theme[download_mid]="#562b00"
theme[download_end]="#562b00"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#653e00"
theme[upload_mid]="#875c26"
theme[upload_end]="#805f36"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#875c26"
theme[process_mid]="#805f36"
theme[process_end]="#563819"
